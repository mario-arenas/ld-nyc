---
import { Picture } from 'astro:assets';
import { widthsFor, type Project } from '../lib/projects';

interface Props {
  project: Project;
  sizes?: string;
  eager?: boolean;
}
const { project, sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw', eager = false } = Astro.props;
---
<article class="card" data-category={project.category}>
  <a href={`/work/${project.slug}/`}>
    <div class="frame">
      <Picture
        src={project.cover}
        widths={widthsFor(project.cover)}
        sizes={sizes}
        formats={['avif', 'webp']}
        alt=""
        loading={eager ? 'eager' : 'lazy'}
      />
    </div>
    <h3>{project.title}</h3>
    <p>{project.category} · {project.photos.length} photos</p>
  </a>
</article>

<style>
  .card a { display: block; text-decoration: none; color: inherit; }
  .frame { aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper-2); }
  .frame :global(picture) { height: 100%; }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .card a:hover .frame :global(img) { transform: scale(1.035); }
  h3 { margin-top: 18px; }
  p {
    margin: 6px 0 0;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
</style>
