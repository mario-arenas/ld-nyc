---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, FEATURED, img, widthsFor } from '../lib/projects';

const featured = FEATURED.map((slug) => projects.find((p) => p.slug === slug)!);
const hero = img('intro/img-11.jpg');
const doris = img('intro/okin_1.jpg');
const trees = img('service/planting-trees.jpg');

const services = [
  {
    title: 'Complete renovations',
    body: 'Lofts, apartments, penthouses and corporate interiors, managed from demolition to the final finish.',
  },
  {
    title: 'Architectural millwork',
    body: 'Wall paneling, louver systems, staircases and built-ins in maple, cherry, mahogany and macassar ebony.',
  },
  {
    title: 'Custom cabinetry',
    body: 'Kitchens, libraries and storage designed around the way you live, with finishes matched to the room.',
  },
  {
    title: 'Green building',
    body: 'Reclaimed wood, natural paints and finishes, and a tree planted for every project we take on.',
  },
];

const press = [
  { title: 'A Life of Picasso', note: 'John Richardson, Vol. III', file: 'thumb-picasso.jpg' },
  { title: 'Vanity Fair', note: '1999', file: 'thumb-vanityFair1999.jpg' },
  { title: 'Home by Design', note: '2009', file: 'thumb-homeByDesign2009.jpg' },
  { title: 'The Big Book of Minimalism', note: 'Book', file: 'thumb-minimalism.jpg' },
  { title: 'Robb Report Luxury Home', note: 'Magazine', file: 'thumb-robbReport.jpg' },
  { title: 'The September 11 Photo Project', note: 'Book', file: 'thumb-september11Project.jpg' },
];
---
<Base
  title="LD Creative Renovations | Architectural Millwork & Renovations in New York"
  description="Family-owned New York renovation firm since 1992: upscale residences, corporate interiors, architectural woodwork and custom cabinetry, built with sustainable materials."
>
  <!-- Hero -->
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">Family-owned · New York · Since 1992</p>
      <h1>Architectural millwork and renovations, made with care.</h1>
      <p class="lede">
        We renovate upscale residences and corporate interiors across New York, with custom woodwork, fine
        cabinetry and natural, sustainable materials at every step.
      </p>
      <div class="actions">
        <a class="btn" href="#contact">Start a project</a>
        <a class="btn btn-ghost" href="/work/">See our work</a>
      </div>
    </div>
    <div class="hero-image">
      <Picture src={hero} widths={widthsFor(hero)} sizes="(max-width: 900px) 100vw, 60vw" formats={['avif', 'webp']} alt="Maple louver wall in the Biggio loft" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <!-- Press strip -->
  <section class="featured-in" aria-label="Featured in">
    <div class="container strip">
      <span class="eyebrow">Featured in</span>
      <ul>
        <li>Vanity Fair</li>
        <li>Robb Report</li>
        <li>Home by Design</li>
        <li><em>A Life of Picasso</em></li>
        <li><em>The Big Book of Minimalism</em></li>
      </ul>
    </div>
  </section>

  <!-- Selected work -->
  <section class="section container" aria-labelledby="work-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="work-title">Homes we've shaped</h2>
      </div>
      <a class="text-link" href="/work/">All {projects.length} projects</a>
    </div>
    <div class="cards">
      {featured.map((p, i) => <ProjectCard project={p} eager={i < 3} />)}
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">What we do</p>
          <h2 id="services-title">Craft at every scale</h2>
        </div>
      </div>
      <ol class="service-list">
        {services.map((s, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section container about" aria-labelledby="about-title">
    <div class="about-image">
      <Picture src={doris} widths={widthsFor(doris)} sizes="(max-width: 900px) 100vw, 45vw" formats={['avif', 'webp']} alt="Doris Lozada in a hard hat on a construction site" />
    </div>
    <div class="about-copy">
      <p class="eyebrow">Our story</p>
      <h2 id="about-title">Founded on trust, built by family</h2>
      <blockquote>“Renovating homes that are healing to mind, body, earth and soul.”</blockquote>
      <p>
        Doris Lozada founded LD Creative Renovations in 1992. Raised in the Andes of Peru, she brings a deep respect
        for natural materials and resourceful building to every project, alongside master carpenter Luis Herrera,
        whose clients call him “Golden Hands Luis.”
      </p>
      <p>
        Art historian John Richardson, author of <em>A Life of Picasso</em>, was both client and mentor. He
        dedicated Volume III to Luis and Doris.
      </p>
    </div>
  </section>

  <!-- Sustainability -->
  <section class="section dark trees" aria-labelledby="trees-title">
    <div class="container trees-grid">
      <div>
        <p class="eyebrow">Sustainability</p>
        <h2 id="trees-title">One tree for every project</h2>
        <p class="lede">
          Construction is a wasteful industry. We work with reclaimed wood and natural paints and finishes, and we
          plant a tree for every project we undertake to give back the wood we use.
        </p>
      </div>
      <div class="trees-image">
        <Picture src={trees} widths={widthsFor(trees)} sizes="(max-width: 900px) 100vw, 40vw" formats={['avif', 'webp']} alt="Planting a tree" />
      </div>
    </div>
  </section>

  <!-- Press -->
  <section id="press" class="section container" aria-labelledby="press-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">Press</p>
        <h2 id="press-title">In print</h2>
      </div>
    </div>
    <ul class="press-list">
      {press.map((p) => {
        const cover = img(`press/${p.file}`);
        return (
          <li>
            <Picture src={cover} widths={widthsFor(cover)} sizes="(max-width: 640px) 50vw, 16vw" formats={['avif', 'webp']} alt="" loading="lazy" />
            <h3>{p.title}</h3>
            <p>{p.note}</p>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- Contact -->
  <section id="contact" class="section dark contact" aria-labelledby="contact-title">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Start a project</p>
        <h2 id="contact-title">Tell us about your space</h2>
        <p class="lede">Planning a renovation, a kitchen or a piece of custom millwork? We'd love to hear about it.</p>
      </div>
      <div class="contact-actions">
        <a class="btn btn-light" href="mailto:dlozada@ld-nyc.com?subject=Project%20inquiry">Email dlozada@ld-nyc.com</a>
        <a class="btn btn-ghost on-dark" href="tel:+17187936420">Call 718.793.6420</a>
        <p>244 Fifth Avenue, Suite H210, New York, NY 10001</p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding-block: clamp(32px, 6vw, 88px) clamp(56px, 8vw, 112px);
  }
  .hero h1 { margin-bottom: 28px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .hero-image :global(img) { width: 100%; aspect-ratio: 4 / 3.2; object-fit: cover; }

  /* Press strip */
  .featured-in { border-block: 1px solid var(--line); }
  .strip { display: flex; align-items: center; gap: 32px; padding-block: 26px; }
  .strip .eyebrow { margin: 0; white-space: nowrap; }
  .strip ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 40px;
    list-style: none;
    margin: 0;
    padding: 0;
    font: 500 1.35rem/1.2 var(--serif);
    color: var(--ink-2);
  }

  /* Work cards */
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(28px, 3vw, 44px) clamp(20px, 2.4vw, 36px); }

  /* Services */
  .services { background: var(--paper-2); }
  .service-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .service-list li { border-top: 1px solid var(--ink); padding-top: 22px; }
  .num { display: block; font: 500 0.8rem/1 var(--sans); letter-spacing: 0.14em; color: var(--ink-2); margin-bottom: 26px; }
  .service-list h3 { margin-bottom: 12px; }
  .service-list p { color: var(--ink-2); margin: 0; }

  /* About */
  .about { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .about-image :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; }
  .about h2 { margin-bottom: 28px; }
  blockquote {
    margin: 0 0 28px;
    padding-left: 22px;
    border-left: 2px solid var(--wood);
    font: italic 500 clamp(1.4rem, 1.2vw + 1rem, 1.9rem)/1.3 var(--serif);
  }
  .about-copy p { color: var(--ink-2); max-width: 34em; }

  /* Sustainability */
  .trees-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .trees h2 { margin-bottom: 24px; }
  .trees-image :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }

  /* Press */
  .press-list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(20px, 2vw, 32px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .press-list :global(img) { width: 100%; aspect-ratio: 275 / 170; object-fit: cover; }
  .press-list h3 { font-size: 1.25rem; margin-top: 14px; }
  .press-list p { margin: 4px 0 0; font-size: 0.85rem; color: var(--ink-2); }

  /* Contact */
  .contact-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 6vw, 96px); align-items: end; }
  .contact h2 { margin-bottom: 20px; }
  .contact-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .contact-actions p { margin: 12px 0 0; color: var(--on-night-2); font-size: 0.95rem; }
  .on-dark { color: var(--on-night); border-color: var(--on-night-2); }
  .on-dark:hover { background: var(--on-night); color: var(--night); border-color: var(--on-night); }

  @media (max-width: 1024px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .service-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .press-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .hero, .about, .trees-grid, .contact-grid { grid-template-columns: 1fr; }
    .hero-image { order: -1; margin-inline: calc(-1 * var(--gutter)); }
    .strip { flex-direction: column; align-items: flex-start; gap: 12px; }
    .strip ul { gap: 6px 24px; font-size: 1.15rem; }
  }
  @media (max-width: 640px) {
    .cards, .service-list { grid-template-columns: 1fr; }
    .press-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .section-head { flex-direction: column; align-items: flex-start; }
  }
</style>
