---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found | LD Creative Renovations" description="This page could not be found." noindex>
  <section class="container notfound">
    <p class="eyebrow">404</p>
    <h1>We couldn't find that page</h1>
    <p class="lede">It may have moved when we updated our website.</p>
    <div class="actions">
      <a class="btn" href="/">Home</a>
      <a class="btn btn-ghost" href="/work/">See our work</a>
      <a class="btn btn-ghost" href="/#contact">Contact us</a>
    </div>
  </section>
</Base>

<style>
  .notfound { padding-block: clamp(72px, 12vw, 160px); }
  .notfound h1 { margin-bottom: 20px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
</style>
