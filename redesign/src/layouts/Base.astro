---
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/jost';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { img } from '../lib/projects';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  noindex?: boolean;
}

const { title, description, image = img('intro/img-11.jpg'), noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: image, format: 'jpg', width: Math.min(1200, image.width) });

const business = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: 'LD Creative Renovations',
  url: 'https://www.ld-nyc.com/',
  telephone: '+1-646-369-4411',
  email: 'ldcreativegroup87@gmail.com',
  foundingDate: '1992',
  founder: { '@type': 'Person', name: 'Doris Lozada' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '91-18 70th Avenue',
    addressLocality: 'Forest Hills',
    addressRegion: 'NY',
    postalCode: '11375',
    addressCountry: 'US',
  },
  areaServed: 'New York City',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#f4f0e8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LD Creative Renovations" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
